{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegentix.local/schemas/cybercore/source-evidence-batch.schema.json",
  "title": "AEGENTIX Cybercore Source Evidence Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "retrieved_at", "evidence"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "batch_id": { "type": "string", "minLength": 1 },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_title",
          "classification",
          "source_authority",
          "source_urls",
          "retrieved_at",
          "official_title",
          "issuer",
          "identifier",
          "publication_date",
          "deadline",
          "official_status",
          "value_description",
          "eligibility",
          "submission_method",
          "issuer_verified",
          "identifier_verified",
          "deadline_verified",
          "evidence_summary",
          "confidence"
        ],
        "properties": {
          "record_id": { "type": ["string", "null"], "pattern": "^opp_[a-f0-9]{24}$" },
          "record_title": { "type": "string", "minLength": 1 },
          "classification": {
            "enum": [
              "VERIFIED_ACTIVE",
              "VERIFIED_FORECAST",
              "VERIFIED_PROGRAM",
              "HISTORICAL",
              "GENERIC_CATEGORY",
              "NO_AUTHORITATIVE_MATCH"
            ]
          },
          "source_authority": { "type": ["string", "null"] },
          "source_urls": {
            "type": "array",
            "items": { "type": "string", "format": "uri", "pattern": "^https://" },
            "uniqueItems": true
          },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "official_title": { "type": ["string", "null"] },
          "issuer": { "type": ["string", "null"] },
          "identifier": { "type": ["string", "null"] },
          "publication_date": { "type": ["string", "null"], "format": "date" },
          "deadline": { "type": ["string", "null"], "format": "date" },
          "official_status": { "type": ["string", "null"] },
          "value_amount": { "type": ["number", "null"], "minimum": 0 },
          "value_currency": { "type": ["string", "null"] },
          "value_description": { "type": ["string", "null"] },
          "eligibility": { "type": "array", "items": { "type": "string" } },
          "submission_method": { "type": ["string", "null"] },
          "issuer_verified": { "type": "boolean" },
          "identifier_verified": { "type": "boolean" },
          "deadline_verified": { "type": "boolean" },
          "evidence_summary": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
